<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        h1, h2 {
            color: #2c3e50;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        .tab {
            overflow: hidden;
            border: 1px solid #ccc;
            background-color: #e0e0e0;
            border-radius: 5px 5px 0 0;
        }
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
            font-size: 16px;
            font-weight: bold;
            color: #1a1a1a;
            border-right: 1px solid #ccc;
        }
        .tab button:hover {
            background-color: #c0c0c0;
        }
        .tab button.active {
            background-color: #3498db;
            color: white;
        }
        .tabcontent {
            display: none;
            padding: 20px;
            border: 1px solid #ccc;
            border-top: none;
            border-radius: 0 0 5px 5px;
            animation: fadeEffect 1s;
        }
        @keyframes fadeEffect {
            from {opacity: 0;}
            to {opacity: 1;}
        }
        form {
            margin-top: 20px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        input[type="text"], input[type="number"], select, textarea {
            width: 100%;
            padding: 8px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        textarea {
            height: 200px;
            font-family: monospace;
        }
        button {
            background-color: #3498db;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }
        button:hover {
            background-color: #2980b9;
        }
        .option-group {
            margin-bottom: 15px;
        }
        .radio-option {
            margin-right: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Certificate Helper</h1>
        <p>Web interface for certificate operations</p>

        <div class="tab">
            <button class="tablinks active" onclick="openTab(event, 'Server')">Server</button>
            <button class="tablinks" onclick="openTab(event, 'PEM')">PEM</button>
            <button class="tablinks" onclick="openTab(event, 'Config')">Config</button>
        </div>

        <!-- Server Tab -->
        <div id="Server" class="tabcontent" style="display: block;">
            <h2>Check Server Certificate</h2>
            <form action="/server" method="post">
                <label for="server">Server Name:</label>
                <input type="text" id="server" name="server" placeholder="e.g. github.com" required>

                <label for="port">Port:</label>
                <input type="number" id="port" name="port" value="443" min="1" max="65535">

                <label for="outputFormat">Output Format:</label>
                <select id="outputFormat" name="outputFormat">
                    <option value="SUMMARY">Summary</option>
                    <option value="TEXT">Text</option>
                    <option value="PEM">PEM</option>
                    <option value="BASE64">BASE64</option>
                </select>

                <label for="certIndex">Certificate Index:</label>
                <input type="text" id="certIndex" name="certIndex" placeholder="e.g. 0,1 (leave empty for all certificates)">

                <button type="submit">Check Certificate</button>
            </form>
        </div>

        <!-- PEM Tab -->
        <div id="PEM" class="tabcontent">
            <h2>Check PEM Certificate</h2>
            <form action="/pem" method="post">
                <label for="pemData">PEM Data:</label>
                <textarea id="pemData" name="pemData" placeholder="Paste PEM certificate data here..." required></textarea>

                <label for="outputFormat">Output Format:</label>
                <select id="outputFormat" name="outputFormat">
                    <option value="SUMMARY">Summary</option>
                    <option value="TEXT">Text</option>
                    <option value="PEM">PEM</option>
                    <option value="BASE64">BASE64</option>
                </select>

                <label for="certIndex">Certificate Index:</label>
                <input type="text" id="certIndex" name="certIndex" placeholder="e.g. 0,1 (leave empty for all certificates)">

                <button type="submit">Check Certificate</button>
            </form>
        </div>

        <!-- Config Tab -->
        <div id="Config" class="tabcontent">
            <h2>Check Config Certificate</h2>
            <form action="/config" method="post">
                <label for="configData">Config Data (JSON):</label>
                <textarea id="configData" name="configData" placeholder="Paste JSON configuration data here..." required></textarea>

                <label for="configKey">Config Key:</label>
                <input type="text" id="configKey" name="configKey" placeholder="e.g. partners.example" required>

                <div class="option-group">
                    <label>Options:</label>
                    <div>
                        <input type="radio" id="hostName" name="option" value="hostName">
                        <label for="hostName" class="radio-option">Host Name</label>

                        <input type="radio" id="jwe" name="option" value="jwe">
                        <label for="jwe" class="radio-option">JWE</label>

                        <input type="radio" id="tls" name="option" value="tls">
                        <label for="tls" class="radio-option">TLS</label>

                        <input type="radio" id="bundle" name="option" value="bundle">
                        <label for="bundle" class="radio-option">Bundle</label>
                    </div>
                </div>

                <label for="outputFormat">Output Format:</label>
                <select id="outputFormat" name="outputFormat">
                    <option value="SUMMARY">Summary</option>
                    <option value="TEXT">Text</option>
                    <option value="PEM">PEM</option>
                    <option value="BASE64">BASE64</option>
                </select>

                <label for="certIndex">Certificate Index:</label>
                <input type="text" id="certIndex" name="certIndex" placeholder="e.g. 0,1 (leave empty for all certificates)">

                <button type="submit">Check Certificate</button>
            </form>
        </div>
    </div>

    <script>
        function openTab(evt, tabName) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.className += " active";
        }
    </script>
</body>
</html>
